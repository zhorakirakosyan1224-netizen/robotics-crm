generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  groups    Group[]
  createdAt DateTime @default(now())
}

model Group {
  id        Int       @id @default(autoincrement())
  name      String
  days      String    @default("")
  startTime String    @default("15:00")
  endTime   String    @default("16:30")
  teacherId Int?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])
  students  Student[]
  createdAt DateTime  @default(now())
}

model Student {
  id               Int          @id @default(autoincrement())
  firstName        String
  lastName         String
  age              Int?
  parentPhone      String
  secondaryPhone   String?
  remainingClasses Int          @default(8)
  status           String       @default("ACTIVE")
  groupId          Int?
  group            Group?       @relation(fields: [groupId], references: [id])
  createdAt        DateTime     @default(now())
  attendances      Attendance[]
  payments         Payment[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  createdAt DateTime @default(now())
}

model Payment {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount       Float
  classesAdded Int
  date         DateTime @default(now())
}